{
  "name": "jobs-private-landing",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test ../../tests/deployment/landing.node.mjs",
    "check": "npm run build && wrangler deploy --dry-run --outdir .build/upload",
    "dev": "npm run build && wrangler dev --ip 127.0.0.1 --port 8788",
    "deploy": "npm run build && wrangler deploy",
    "test:browser": "playwright test --config ../../tests/deployment/landing.playwright.config.mjs"
  },
  "devDependencies": { "wrangler": "4.151.1" }
}
